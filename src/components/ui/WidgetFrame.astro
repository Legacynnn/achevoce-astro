---
import Grain from '../bg/Grain.astro';

interface Props {
  label: string;
  tilt?: 'left' | 'right' | 'none';
  skin?: 'violet' | 'ember' | 'leaf' | 'ink';
  class?: string;
}

const { label, tilt = 'left', skin = 'violet', class: className = '' } = Astro.props;

const tilts = {
  left: 'md:[transform:perspective(1600px)_rotateY(-6deg)_rotateX(3deg)]',
  right: 'md:[transform:perspective(1600px)_rotateY(6deg)_rotateX(3deg)]',
  none: ''
};

const skins = {
  violet: {
    bg: 'radial-gradient(110% 130% at 8% 4%, var(--color-violet-400) 0%, transparent 58%), radial-gradient(90% 110% at 96% 96%, var(--color-violet-950) 0%, transparent 62%), linear-gradient(135deg, var(--color-violet-600), var(--color-violet-800))',
    glow: 'var(--color-violet-400)'
  },
  ember: {
    bg: 'radial-gradient(120% 120% at 96% 6%, var(--color-rust-400) 0%, transparent 52%), radial-gradient(90% 120% at 6% 92%, var(--color-violet-700) 0%, transparent 64%), linear-gradient(200deg, var(--color-violet-500), var(--color-violet-900))',
    glow: 'var(--color-rust-400)'
  },
  leaf: {
    bg: 'radial-gradient(120% 120% at 4% 92%, var(--color-leaf-400) 0%, transparent 52%), radial-gradient(100% 100% at 88% 6%, var(--color-violet-400) 0%, transparent 58%), linear-gradient(320deg, var(--color-violet-700), var(--color-violet-900))',
    glow: 'var(--color-leaf-400)'
  },
  ink: {
    bg: 'conic-gradient(from 210deg at 30% 20%, var(--color-violet-600) 0deg, var(--color-violet-950) 130deg, var(--color-violet-800) 250deg, var(--color-violet-600) 360deg)',
    glow: 'var(--color-violet-500)'
  }
};

const s = skins[skin];
---

<div
  class:list={[
    'relative isolate overflow-hidden rounded-card p-4 sm:p-7 lg:p-8 shadow-lg transition-transform duration-700 ease-[var(--ease-out)] hover:[transform:perspective(1600px)_rotateY(0deg)_rotateX(0deg)]',
    tilts[tilt],
    className
  ]}
  style={`background:${s.bg}`}
>
  <div
    class="pointer-events-none absolute -inset-8 -z-10 rounded-[3rem] opacity-70 blur-3xl"
    style={`background:radial-gradient(60% 60% at 50% 50%, color-mix(in oklab, ${s.glow} 34%, transparent), transparent 72%)`}
    aria-hidden="true"
  >
  </div>

  <Grain opacity={0.16} blend="overlay" />

  <div class="relative rounded-inner bg-bg overflow-hidden">
    <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-5">
      <span class="micro text-fg-subtle">{label}</span>
      <span class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-1.5 w-1.5 rounded-full bg-border-strong"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-border-strong"></span>
        <span class="h-1.5 w-6 rounded-full bg-border"></span>
      </span>
    </div>
    <div class="p-4 sm:p-5">
      <slot />
    </div>
  </div>
</div>
