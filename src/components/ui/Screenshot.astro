---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  label = 'app.achevoce.com.br',
  sizes = '(min-width: 1024px) 46vw, 92vw',
  loading = 'lazy',
  class: className = ''
} = Astro.props;
---

<figure
  class:list={[
    'min-w-0 overflow-hidden contain-paint rounded-card border border-border bg-bg-raised shadow-lift',
    className
  ]}
>
  <div class="flex items-center gap-3 border-b border-border bg-sand-200 px-4 py-2.5">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2 rounded-full bg-sand-400"></span>
      <span class="size-2 rounded-full bg-sand-400"></span>
      <span class="size-2 rounded-full bg-sand-400"></span>
    </span>
    <span
      class="truncate rounded-pill bg-bg-raised px-3 py-1 text-[0.6875rem] tracking-wide text-fg-subtle"
      >{label}</span
    >
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[520, 800, 1200, 1600]}
    sizes={sizes}
    loading={loading}
    format="webp"
    quality={72}
    class="block w-full"
  />
</figure>
