---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  eyebrowIcon?: string;
  title: string | string[];
  tone?: 'light' | 'ink';
  align?: 'start' | 'center';
  class?: string;
}

const {
  eyebrow,
  eyebrowIcon,
  title,
  tone = 'light',
  align = 'start',
  class: className = ''
} = Astro.props;

const lines = Array.isArray(title) ? title : [title];
---

<div
  class:list={[
    'flex flex-col gap-6',
    align === 'center' && 'items-center text-center',
    className
  ]}
>
  <div class="reveal" data-reveal>
    <Eyebrow tone={tone} icon={eyebrowIcon}>{eyebrow}</Eyebrow>
  </div>

  <h2
    class:list={[
      'text-h2',
      tone === 'ink' ? 'text-fg-on-ink' : 'text-fg',
      align === 'center' && 'max-w-[22ch]'
    ]}
  >
    {
      lines.map((line, i) => (
        <span class="line-mask" data-reveal style={`--i:${i}`}>
          <span>{line}</span>
        </span>
      ))
    }
  </h2>

  {
    Astro.slots.has('default') && (
      <p
        class:list={[
          'text-lead measure reveal',
          tone === 'ink' ? 'text-fg-on-ink-muted' : 'text-fg-muted'
        ]}
        style="--i:2"
        data-reveal
      >
        <slot />
      </p>
    )
  }
</div>
