---
interface Props {
  tone?: 'neutral' | 'raised' | 'clay' | 'moss';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones = {
  neutral: 'border-border text-fg-muted',
  raised: 'border-border bg-bg-raised text-fg',
  clay: 'border-clay-600/25 text-clay-600',
  moss: 'border-moss-600/25 text-moss-600'
};
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-pill border px-3.5 py-1.5 text-[0.8125rem] leading-none font-medium',
    tones[tone],
    className
  ]}
>
  <slot />
</span>
