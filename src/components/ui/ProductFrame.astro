---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  label = 'app.achevoce.com.br',
  sizes = '(min-width: 1488px) 1328px, (min-width: 768px) calc(100vw - 5rem), calc(100vw - 3rem)',
  loading = 'eager',
  class: className = ''
} = Astro.props;
---

<figure
  class:list={[
    'relative isolate overflow-hidden contain-paint rounded-frame border border-border bg-bg-raised shadow-frame',
    className
  ]}
>
  <div class="border-b border-border bg-sand-200 px-4 py-3 sm:px-6">
    <span class="eyebrow block truncate text-[0.6875rem] normal-case">{label}</span>
  </div>

  <div class="relative isolate aspect-square overflow-hidden contain-paint sm:aspect-[1586/630]">
    <Image
      src={src}
      alt={alt}
      widths={[760, 1100, 1600, 2200]}
      sizes={sizes}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      format="webp"
      quality={78}
      class="absolute top-0 left-0 block w-full origin-top-left scale-[2.05] sm:scale-100"
    />
  </div>
</figure>
