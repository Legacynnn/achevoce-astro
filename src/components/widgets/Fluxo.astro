---
import { Icon } from 'astro-icon/components';
import ItemThumb from '../ui/ItemThumb.astro';
import { busca, fluxo } from '../../data/content.ts';

const { pedido, status } = fluxo;

const tipoLabel: Record<string, string> = {
  medicamento: 'Medicamento',
  insumo: 'Insumo',
  equipamento: 'Equipamento'
};

const tipoIcon: Record<string, string> = {
  medicamento: 'medicine-bottle-01',
  insumo: 'package',
  equipamento: 'cardiogram-01'
};

const alvo = busca.items.find((i) => i.nome === fluxo.alvo) ?? busca.items[0];
const durs = status.map((s) => s.dur).join(',');
---

<div
  class="relative rounded-card bg-[linear-gradient(140deg,color-mix(in_oklab,var(--color-violet-400)_38%,transparent),color-mix(in_oklab,var(--color-violet-800)_50%,transparent))] p-1.5 shadow-frame ring-1 ring-white/15"
  data-fluxo
  data-durs={durs}
  aria-hidden="true"
>
  <div class="overflow-hidden rounded-[18px] bg-bg select-none">
    <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
      <span class="flex min-w-0 items-center gap-2">
        {
          ['layers-01', 'package-search', 'mail-send-01', 'payment-success-02', 'package-delivered'].map(
            (n, i) => (
              <span class="shrink-0" data-ticon={i} hidden={i > 0}>
                <Icon name={`hugeicons:${n}`} class="block h-4 w-4 text-violet-600" />
              </span>
            )
          )
        }
        <span class="micro truncate text-fg-subtle" data-title>{fluxo.label}</span>
      </span>
      <span class="flex shrink-0 items-center gap-1.5 text-[0.6875rem] text-fg-subtle">
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet-500 opacity-70"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-violet-500"></span>
        </span>
        {fluxo.badge}
      </span>
    </div>

    <div class="relative h-[24.5rem] overflow-hidden">
      <div class="view absolute inset-0 flex flex-col" data-view="0">
        <div class="px-4 pt-4">
          <div
            class="field flex items-center gap-2.5 rounded-field border border-border bg-bg-subtle px-3 py-3 transition-colors duration-300"
          >
            <Icon name="hugeicons:search-01" class="h-4 w-4 shrink-0 text-fg-subtle" />
            <span class="flex min-w-0 flex-1 items-center text-[0.9375rem]">
              <span class="truncate text-fg" data-typed></span>
              <span class="caret"></span>
              <span class="truncate text-fg-subtle" data-ph>{busca.placeholder}</span>
            </span>
            <Icon name="hugeicons:filter" class="h-4 w-4 shrink-0 text-fg-subtle" />
          </div>

          <div class="chips mt-3 flex gap-1.5 overflow-hidden">
            {
              busca.chips.map((c, i) => (
                <span
                  class:list={[
                    'micro inline-flex shrink-0 items-center gap-1.5 rounded-pill border py-1.5 pr-2.5 pl-2',
                    i === 0
                      ? 'border-violet-600 bg-violet-600 text-cta-fg'
                      : 'border-border text-fg-subtle'
                  ]}
                >
                  <Icon name={`hugeicons:${c.icon}`} class="h-3.5 w-3.5 shrink-0" />
                  {c.label}
                </span>
              ))
            }
          </div>
        </div>

        <ul class="results mt-3 flex min-h-0 flex-1 flex-col gap-2 overflow-hidden px-4 pb-4">
          <li class="micro order-1 hidden items-center gap-1.5 pt-1 text-fg-subtle" data-divider>
            <Icon name="hugeicons:layers-01" class="h-3.5 w-3.5 shrink-0" />
            Outros itens da rede
          </li>
          {
            busca.items.map((it) => (
              <li
                class="hit order-0 flex shrink-0 items-center gap-3 rounded-field border border-border bg-bg p-2.5 transition-all duration-300 ease-[var(--ease-out)]"
                data-hit={it.nome}
                data-hay={`${it.nome} ${it.detalhe} ${tipoLabel[it.tipo]}`.toLowerCase()}
              >
                <ItemThumb art={it.art} icon={it.icon} size={44} class="!rounded-[10px]" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[0.875rem] font-medium text-fg">{it.nome}</span>
                  <span class="tnum mt-0.5 block truncate text-[0.75rem] text-fg-muted">
                    {it.detalhe}
                  </span>
                  <span class="mt-1 flex items-center gap-2 text-[0.75rem]">
                    <span class="micro inline-flex shrink-0 items-center gap-1 rounded-pill bg-bg-panel py-0.5 pr-1.5 pl-1 text-fg-subtle">
                      <Icon name={`hugeicons:${tipoIcon[it.tipo]}`} class="h-3 w-3 shrink-0" />
                      {tipoLabel[it.tipo]}
                    </span>
                    <span
                      class:list={[
                        'tnum inline-flex min-w-0 items-center gap-1',
                        it.urgente ? 'text-rust-600' : 'text-fg-subtle'
                      ]}
                    >
                      <Icon
                        name={`hugeicons:${it.urgente ? 'clock-01' : 'time-schedule'}`}
                        class="h-3.5 w-3.5 shrink-0"
                      />
                      <span class="truncate">{it.prazo}</span>
                    </span>
                  </span>
                </span>
                <span class="cta micro inline-flex shrink-0 items-center gap-1 rounded-pill bg-violet-600 px-2.5 py-1.5 text-cta-fg">
                  <Icon name="hugeicons:package-add" class="h-3.5 w-3.5 shrink-0" />
                  Solicitar
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="view absolute inset-0 flex flex-col px-4 py-4" data-view="1" hidden>
        <div class="flex items-center gap-3 rounded-field border border-border bg-bg-subtle p-2.5">
          <ItemThumb art={alvo.art} icon={alvo.icon} size={44} class="!rounded-[10px]" />
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[0.875rem] font-medium text-fg">{alvo.nome}</span>
            <span class="tnum mt-0.5 block truncate text-[0.75rem] text-fg-muted">
              {alvo.detalhe}
            </span>
          </span>
          <Icon name="hugeicons:package-search" class="h-5 w-5 shrink-0 text-violet-600" />
        </div>

        <dl class="mt-3 flex flex-col divide-y divide-border rounded-field border border-border">
          {
            pedido.campos.map((c, i) => (
              <div
                class="flip flex items-center justify-between gap-3 px-3 py-2.5"
                style={`--d:${160 + i * 120}ms`}
              >
                <dt class="micro flex shrink-0 items-center gap-2 text-fg-subtle">
                  <Icon name={`hugeicons:${c.icon}`} class="h-4 w-4 shrink-0 text-violet-600" />
                  {c.k}
                </dt>
                <dd class="truncate text-right text-[0.8125rem] text-fg-muted">{c.v}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-3 flex items-start gap-2 text-[0.75rem] leading-snug text-fg-subtle">
          <Icon name="hugeicons:shield-01" class="mt-px h-3.5 w-3.5 shrink-0" />
          {pedido.nota}
        </p>

        <span
          class="send mt-auto flex h-11 items-center justify-center gap-2 rounded-field bg-violet-600 text-[0.875rem] font-medium text-cta-fg transition-transform duration-200"
          data-send
        >
          <Icon name={`hugeicons:${pedido.ctaIcon}`} class="h-4 w-4 shrink-0" data-send-icon />
          <span data-send-label>{pedido.cta}</span>
        </span>
      </div>

      {
        status.map((st, i) => (
          <div
            class="view absolute inset-0 flex flex-col items-center justify-center px-6 text-center"
            data-view={2 + i}
            hidden
          >
            <span class="burst relative grid h-20 w-20 shrink-0 place-items-center">
              <i class="ring" />
              <i class="ring ring-b" />
              <span class="bolt grid h-16 w-16 place-items-center rounded-pill bg-violet-100 text-violet-700">
                <Icon name={`hugeicons:${st.icon}`} class="h-8 w-8" />
              </span>
              <i class="spark spark-a">
                <Icon name="hugeicons:sparkles" class="h-3.5 w-3.5" />
              </i>
              <i class="spark spark-b">
                <Icon name="hugeicons:flash" class="h-3 w-3" />
              </i>
            </span>

            <p class="pop mt-5 text-[1.0625rem] font-medium text-fg" style="--d:120ms">
              {st.titulo}
            </p>
            <p
              class="pop mt-2 max-w-[36ch] text-[0.875rem] leading-snug text-fg-muted"
              style="--d:220ms"
            >
              {st.corpo}
            </p>
            <p class="pop tnum mt-2.5 font-mono text-[0.6875rem] text-fg-subtle" style="--d:320ms">
              {st.meta}
            </p>

            {st.rota && (
              <span class="rota mt-5 flex w-full max-w-[17rem] items-center gap-2" aria-hidden="true">
                <Icon name={`hugeicons:${st.rota.de}`} class="h-4 w-4 shrink-0 text-violet-600" />
                <span class="lane relative h-px flex-1">
                  <i class="truck">
                    <Icon name={`hugeicons:${st.rota.icon}`} class="h-4 w-4" />
                  </i>
                </span>
                <Icon name={`hugeicons:${st.rota.para}`} class="h-4 w-4 shrink-0 text-violet-600" />
              </span>
            )}

            <ul class="mt-5 flex flex-wrap items-center justify-center gap-1.5">
              {st.tags.map((t, k) => (
                <li
                  class="pop micro inline-flex items-center gap-1.5 rounded-pill bg-violet-50 px-2.5 py-1.5 text-violet-800"
                  style={`--d:${420 + k * 120}ms`}
                >
                  <Icon name={`hugeicons:${t.icon}`} class="h-3.5 w-3.5 shrink-0" />
                  {t.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="flex items-center gap-2 border-t border-border px-4 py-3">
      <Icon name="hugeicons:route-02" class="h-3.5 w-3.5 shrink-0 text-fg-subtle" />
      <p class="truncate text-[0.75rem] text-fg-subtle">{fluxo.hint}</p>
    </div>
  </div>
</div>

<style>
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-inline: 1px;
    translate: 0 0.12em;
    background: var(--color-violet-500);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  [data-fluxo][data-typing] .field {
    border-color: color-mix(in oklab, var(--color-violet-400) 70%, transparent);
    background: var(--color-bg);
  }

  .chips {
    mask-image: linear-gradient(to right, #000 88%, transparent 100%);
  }

  .results {
    mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
  }

  .hit[data-off] {
    order: 2;
    opacity: 0.45;
  }

  .hit[data-off] .cta {
    display: none;
  }

  .hit .cta {
    display: none;
  }

  .hit[data-pick] .cta {
    display: inline-flex;
    animation: pop-in 0.35s var(--ease-out) both;
  }

  .hit[data-pick] {
    border-color: color-mix(in oklab, var(--color-violet-400) 70%, transparent);
    box-shadow: var(--shadow-md);
  }

  .hit[data-press] {
    transform: scale(0.985);
  }

  .hit[data-press] .cta {
    background: var(--color-violet-700);
  }

  @keyframes view-in {
    from {
      opacity: 0;
      transform: translate3d(14px, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes view-back {
    from {
      opacity: 0;
      transform: translate3d(-14px, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .view:not([hidden]) {
    animation: view-in 0.45s var(--ease-out) both;
  }

  [data-fluxo][data-back] .view:not([hidden]) {
    animation-name: view-back;
  }

  @keyframes flip-in {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .view:not([hidden]) .flip {
    animation: flip-in 0.45s var(--ease-out) var(--d) both;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .view:not([hidden]) .pop {
    animation: pop-in 0.5s var(--ease-out) var(--d, 0ms) both;
  }

  @keyframes bolt-in {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(-12deg);
    }
    55% {
      opacity: 1;
      transform: scale(1.14) rotate(4deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes ring-out {
    from {
      opacity: 0.55;
      transform: scale(0.62);
    }
    to {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  @keyframes spark-in {
    0% {
      opacity: 0;
      transform: scale(0.3) translate3d(0, 6px, 0);
    }
    60% {
      opacity: 1;
      transform: scale(1.1) translate3d(0, 0, 0);
    }
    100% {
      opacity: 0.9;
      transform: scale(1) translate3d(0, 0, 0);
    }
  }

  .burst .ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1.5px solid color-mix(in oklab, var(--color-violet-500) 55%, transparent);
    opacity: 0;
  }

  .view:not([hidden]) .ring {
    animation: ring-out 1.9s var(--ease-out) infinite;
  }

  .view:not([hidden]) .ring-b {
    animation-delay: 0.75s;
  }

  .view:not([hidden]) .bolt {
    animation: bolt-in 0.7s var(--ease-out) both;
  }

  .spark {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--color-violet-500);
    opacity: 0;
  }

  .spark-a {
    top: -2px;
    right: 0;
  }

  .spark-b {
    bottom: 2px;
    left: -2px;
  }

  .view:not([hidden]) .spark-a {
    animation: spark-in 0.6s var(--ease-out) 0.42s both;
  }

  .view:not([hidden]) .spark-b {
    animation: spark-in 0.6s var(--ease-out) 0.58s both;
  }

  .rota .lane {
    background: repeating-linear-gradient(
      to right,
      var(--color-border-strong) 0 4px,
      transparent 4px 9px
    );
  }

  .rota .truck {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    margin-top: -8px;
    padding-inline: 3px;
    background: var(--color-bg);
    color: var(--color-violet-600);
  }

  .view:not([hidden]) .truck {
    animation: drive 2.6s var(--ease-inout) 0.4s infinite;
  }

  @keyframes drive {
    0% {
      left: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      left: 100%;
      transform: translateX(-100%);
      opacity: 0;
    }
  }

  .send[data-press] {
    transform: scale(0.985);
    background: var(--color-violet-700);
  }

  [data-fluxo][data-sending] [data-send-icon] {
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .dots::after {
    content: '';
    animation: dots 1.2s steps(4) infinite;
  }

  @keyframes dots {
    0% {
      content: '';
    }
    25% {
      content: '.';
    }
    50% {
      content: '..';
    }
    75% {
      content: '...';
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret,
    .dots::after,
    .view:not([hidden]) .ring,
    .view:not([hidden]) .truck,
    [data-fluxo][data-sending] [data-send-icon] {
      animation: none;
    }

    .view:not([hidden]),
    .view:not([hidden]) .flip,
    .view:not([hidden]) .pop,
    .view:not([hidden]) .bolt,
    .view:not([hidden]) .spark-a,
    .view:not([hidden]) .spark-b {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-fluxo]');

  if (root) {
    const views = [...root.querySelectorAll<HTMLElement>('[data-view]')];
    const hits = [...root.querySelectorAll<HTMLElement>('[data-hit]')];
    const divider = root.querySelector<HTMLElement>('[data-divider]')!;
    const typed = root.querySelector<HTMLElement>('[data-typed]')!;
    const ph = root.querySelector<HTMLElement>('[data-ph]')!;
    const send = root.querySelector<HTMLElement>('[data-send]')!;
    const sendLabel = root.querySelector<HTMLElement>('[data-send-label]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const ticons = [...root.querySelectorAll<HTMLElement>('[data-ticon]')];

    const query = 'dipirona';
    const alvo = 'Dipirona sódica 500 mg/mL';
    const durs = (root.dataset.durs ?? '').split(',').map((n) => Number(n) || 3000);
    const labels = ['Busca da rede', 'Solicitação', 'Solicitação enviada', 'Pagamento confirmado', 'Medicamento recebido'];
    const ctaLabel = sendLabel.textContent ?? '';

    const filter = (q: string) => {
      for (const li of hits)
        li.toggleAttribute('data-off', !!q && !(li.dataset.hay ?? '').includes(q));
      divider.classList.toggle('hidden', !q);
      divider.classList.toggle('flex', !!q);
    };

    const view = (i: number, back = false) => {
      root.toggleAttribute('data-back', back);
      for (const [j, v] of views.entries()) v.hidden = j !== i;
      for (const [j, ic] of ticons.entries()) ic.hidden = j !== i;
      title.textContent = labels[i] ?? labels[0];
    };

    const reset = () => {
      typed.textContent = '';
      ph.hidden = false;
      filter('');
      for (const li of hits) {
        li.removeAttribute('data-pick');
        li.removeAttribute('data-press');
      }
      send.removeAttribute('data-press');
      sendLabel.textContent = ctaLabel;
      sendLabel.classList.remove('dots');
      root.removeAttribute('data-typing');
      root.removeAttribute('data-sending');
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      typed.textContent = query;
      ph.hidden = true;
      filter(query);
      view(0);
    } else {
      let session = 0;
      let running = false;
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

      const type = async (text: string, my: number) => {
        ph.hidden = true;
        for (let i = 1; i <= text.length && my === session; i++) {
          typed.textContent = text.slice(0, i);
          filter(text.slice(0, i).toLowerCase());
          await wait(90);
        }
      };

      const play = async (my: number) => {
        while (my === session) {
          reset();
          view(0);
          await wait(1300);
          if (my !== session) return;

          root.setAttribute('data-typing', '');
          await type(query, my);
          root.removeAttribute('data-typing');
          await wait(800);
          if (my !== session) return;

          const pick = hits.find((li) => li.dataset.hit === alvo);
          pick?.setAttribute('data-pick', '');
          await wait(1100);
          if (my !== session) return;

          pick?.setAttribute('data-press', '');
          await wait(320);
          pick?.removeAttribute('data-press');
          await wait(180);
          if (my !== session) return;

          view(1);
          await wait(2400);
          if (my !== session) return;

          send.setAttribute('data-press', '');
          await wait(320);
          send.removeAttribute('data-press');
          sendLabel.textContent = 'Enviando';
          sendLabel.classList.add('dots');
          root.setAttribute('data-sending', '');
          await wait(1400);
          if (my !== session) return;
          root.removeAttribute('data-sending');

          for (const [k, ms] of durs.entries()) {
            view(2 + k);
            await wait(ms);
            if (my !== session) return;
          }

          view(0, true);
          await wait(600);
        }
      };

      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((e) => e.isIntersecting);
          if (visible && !running) {
            running = true;
            play(++session);
          } else if (!visible && running) {
            running = false;
            session++;
          }
        },
        { threshold: 0.25 }
      );

      view(0);
      io.observe(root);
    }
  }
</script>
