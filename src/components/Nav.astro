---
import Logo from './ui/Logo.astro';
import { nav, site } from '../data/content.ts';
---

<header class="fixed inset-x-0 top-0 z-50 pt-[max(0.75rem,var(--safe-top))]">
  <div class="container-header">
    <nav
      id="site-nav"
      data-state="hero"
      class="group/nav relative flex items-center justify-between gap-2 rounded-pill border border-transparent bg-transparent pr-2 pl-3 sm:gap-4 sm:pr-2 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500 ease-[var(--ease-out)] data-[state=float]:border-border data-[state=float]:bg-bg/88 data-[state=float]:shadow-md data-[state=float]:backdrop-blur-xl data-[state=float]:backdrop-saturate-150 data-[state=ink]:border-border-ink data-[state=ink]:bg-bg-ink/64 data-[state=ink]:shadow-md data-[state=ink]:backdrop-blur-xl data-[state=ink]:backdrop-saturate-150 sm:pl-5 supports-[not(backdrop-filter:blur(1px))]:data-[state=float]:bg-bg/96 supports-[not(backdrop-filter:blur(1px))]:data-[state=ink]:bg-bg-ink/92"
      aria-label="Principal"
    >
      <a
        href="#topo"
        class="mark nav-in flex h-11 shrink-0 items-center gap-2.5 rounded-pill pr-2"
        style="--i:0"
        aria-label={`${site.name} — início`}
      >
        <Logo class="glyph h-6" />
        <span
          class="hidden font-display text-[1.0625rem] font-medium tracking-[-0.03em] whitespace-nowrap text-fg-on-ink transition-colors duration-500 min-[26rem]:block group-data-[state=float]/nav:text-fg"
        >
          Ache Você
        </span>
      </a>

      <ul class="links relative hidden items-center gap-1 lg:flex">
        <li class="ind" aria-hidden="true"></li>
        {
          nav.links.map((l, i) => (
            <li style={`--i:${i + 1}`}>
              <a
                href={l.href}
                data-spy
                class="relative flex h-11 items-center rounded-pill px-3 text-[0.875rem] font-medium text-fg-on-ink-muted transition-colors duration-300 hover:text-fg-on-ink aria-[current]:text-fg-on-ink group-data-[state=float]/nav:text-fg-muted group-data-[state=float]/nav:hover:text-fg group-data-[state=float]/nav:aria-[current]:text-fg"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex shrink-0 items-center gap-1">
        <a
          href={site.login}
          style={`--i:${nav.links.length + 1}`}
          class="nav-in hidden h-11 items-center rounded-pill px-3 text-[0.875rem] font-medium text-fg-on-ink-muted transition-colors duration-300 hover:text-fg-on-ink group-data-[state=float]/nav:text-fg-muted group-data-[state=float]/nav:hover:text-fg sm:inline-flex"
        >
          Entrar
        </a>
        <a
          href={site.cta}
          style={`--i:${nav.links.length + 2}`}
          class="cta nav-in inline-flex h-11 items-center rounded-pill bg-fg-on-ink px-4 text-[0.875rem] font-medium text-bg-ink transition-[background-color,color,transform] duration-500 ease-[var(--ease-out)] hover:bg-white group-data-[state=float]/nav:bg-cta group-data-[state=float]/nav:text-cta-fg group-data-[state=float]/nav:hover:bg-cta-hover"
        >
          <span class="hidden sm:inline">{nav.cta}</span>
          <span class="sm:hidden">Pré-cadastro</span>
        </a>
        <button
          type="button"
          style={`--i:${nav.links.length + 3}`}
          class="burger nav-in grid h-11 w-11 place-items-center rounded-pill text-fg-on-ink transition-colors duration-300 hover:bg-white/10 group-data-[state=float]/nav:text-fg group-data-[state=float]/nav:hover:bg-bg-panel lg:hidden"
          aria-label="Abrir navegação"
          aria-expanded="false"
          data-menu-open
        >
          <span class="bars" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<dialog
  data-menu
  class="m-0 w-full max-w-none bg-transparent p-0 backdrop:bg-slate-950/50 backdrop:backdrop-blur-sm"
>
  <div class="container-header pt-[max(0.75rem,var(--safe-top))]">
    <div class="sheet rounded-card border border-border bg-bg p-4 shadow-lg">
      <div class="flex h-10 items-center justify-between">
        <span class="micro text-fg-subtle">Navegação</span>
        <button
          type="button"
          class="grid h-11 w-11 place-items-center rounded-pill text-fg hover:bg-bg-panel"
          aria-label="Fechar navegação"
          data-menu-close
        >
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" aria-hidden="true">
            <path
              d="M5.5 5.5l9 9m0-9l-9 9"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <ul class="mt-2 flex flex-col">
        {
          nav.links.map((l, i) => (
            <li class="border-b border-border last:border-0" style={`--i:${i}`}>
              <a
                href={l.href}
                class="block py-3.5 font-display text-xl font-medium tracking-[-0.026em] text-fg"
                data-menu-link
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={site.login}
        style={`--i:${nav.links.length}`}
        data-menu-link
        class="mt-4 flex h-12 items-center justify-center rounded-pill border border-border-strong text-[0.9375rem] font-medium text-fg"
      >
        Entrar
      </a>
    </div>
  </div>
</dialog>

<style>
  #site-nav {
    height: 3.5rem;
    transition-property: background-color, border-color, box-shadow, backdrop-filter, height;
  }

  @media (width >= 48rem) {
    #site-nav {
      height: 4rem;
    }
  }

  #site-nav[data-state='float'],
  #site-nav[data-state='ink'] {
    height: 3.25rem;
  }

  @media (width >= 48rem) {
    #site-nav[data-state='float'],
    #site-nav[data-state='ink'] {
      height: 3.5rem;
    }
  }

  .ind {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.25rem;
    width: var(--w, 0px);
    border-radius: var(--radius-pill);
    background: oklch(1 0 0 / 0.1);
    opacity: var(--o, 0);
    transform: translate3d(var(--x, 0px), -50%, 0);
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.35s var(--ease-out),
      background-color 0.5s var(--ease-out);
    pointer-events: none;
  }

  #site-nav[data-state='float'] .ind {
    background: var(--color-bg-panel);
  }

  .glyph {
    transition: transform 0.6s var(--ease-out);
  }

  .mark:hover .glyph {
    transform: rotate(-8deg) scale(1.06);
  }

  .cta {
    transform: scale(1);
  }

  #site-nav[data-state='float'] .cta,
  #site-nav[data-state='ink'] .cta {
    transform: scale(0.96);
  }

  .cta:active {
    transform: scale(0.94);
  }

  .bars {
    position: relative;
    display: block;
    width: 17px;
    height: 11px;
  }

  .bars > i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out);
  }

  .bars > i:first-child {
    top: 0;
  }

  .bars > i:last-child {
    bottom: 0;
  }

  .burger[aria-expanded='true'] .bars > i:first-child {
    transform: translate3d(0, 4.7px, 0) rotate(45deg);
  }

  .burger[aria-expanded='true'] .bars > i:last-child {
    transform: translate3d(0, -4.7px, 0) rotate(-45deg);
  }

  @keyframes nav-drop {
    from {
      opacity: 0;
      transform: translate3d(0, -16px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes nav-item {
    from {
      opacity: 0;
      transform: translate3d(0, -9px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  html[data-js] #site-nav {
    animation: nav-drop 0.85s var(--ease-out) backwards;
  }

  html[data-js] #site-nav .nav-in,
  html[data-js] .links > li:not(.ind) {
    animation: nav-item 0.65s var(--ease-out) backwards;
    animation-delay: calc(var(--i, 0) * 55ms + 150ms);
  }

  dialog[open] .sheet {
    animation: nav-item 0.5s var(--ease-out) backwards;
  }

  dialog[open] [data-menu-link] {
    animation: nav-item 0.55s var(--ease-out) backwards;
    animation-delay: calc(var(--i, 0) * 55ms + 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-nav,
    #site-nav *,
    dialog * {
      animation: none !important;
    }

    .ind,
    .glyph,
    .cta,
    .bars > i {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('site-nav');
  const inkBlocks = [...document.querySelectorAll<HTMLElement>('[data-ink]')];

  if (bar && inkBlocks.length) {
    const overInk = new Set<Element>();
    let io: IntersectionObserver | null = null;
    let lifted = false;

    const sync = () => {
      bar.dataset.state = overInk.size ? (lifted ? 'ink' : 'hero') : 'float';
    };

    const build = () => {
      io?.disconnect();
      const line = bar.getBoundingClientRect().bottom;
      const bottom = Math.max(0, innerHeight - line - 2);
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) overInk.add(e.target);
            else overInk.delete(e.target);
          }
          sync();
        },
        { rootMargin: `-${line}px 0px -${bottom}px 0px`, threshold: 0 }
      );
      for (const el of inkBlocks) io.observe(el);
    };

    build();

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const next = lifted ? scrollY > 8 : scrollY > 40;
        if (next !== lifted) {
          lifted = next;
          sync();
        }
        ticking = false;
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    let t = 0;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(build, 200);
    });
  }

  const list = document.querySelector<HTMLElement>('.links');
  const ind = list?.querySelector<HTMLElement>('.ind');
  const spies = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];

  if (list && ind && spies.length) {
    const targets = new Map<Element, HTMLAnchorElement>();
    for (const a of spies) {
      const el = document.querySelector(a.getAttribute('href') ?? '');
      if (el) targets.set(el, a);
    }

    const seen = new Set<Element>();
    let current: HTMLAnchorElement | null = null;

    const place = (a: HTMLAnchorElement | null) => {
      if (!a) {
        ind.style.setProperty('--o', '0');
        return;
      }
      ind.style.setProperty('--x', `${a.offsetLeft}px`);
      ind.style.setProperty('--w', `${a.offsetWidth}px`);
      ind.style.setProperty('--o', '1');
    };

    const pick = () => {
      const next = spies.find((a) => {
        const el = document.querySelector(a.getAttribute('href') ?? '');
        return el && seen.has(el);
      });
      current?.removeAttribute('aria-current');
      current = next ?? null;
      current?.setAttribute('aria-current', 'true');
      place(current);
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target);
          else seen.delete(e.target);
        }
        pick();
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: 0 }
    );
    for (const el of targets.keys()) spy.observe(el);

    for (const a of spies) {
      a.addEventListener('pointerenter', () => place(a));
      a.addEventListener('focus', () => place(a));
    }
    list.addEventListener('pointerleave', () => place(current));
    list.addEventListener('focusout', () => place(current));
    addEventListener('resize', () => place(current));
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && openBtn) {
    const close = () => dialog.close();
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    dialog.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'));
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close);
    for (const a of dialog.querySelectorAll('[data-menu-link]')) {
      a.addEventListener('click', close);
    }
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
  }
</script>
