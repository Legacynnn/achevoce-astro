---
import { NAV_LINKS, SITE } from '../lib/site';
import { footer } from '../data/content';
import Logo from './ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-muted pb-[var(--safe-bottom)]">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr] md:py-20">
    <div class="max-w-md">
      <Logo class="w-11" title="Ache Você" />
      <p class="mt-5 text-[0.9375rem] text-fg-muted">{footer.tagline}</p>
    </div>

    <nav aria-label="Rodapé" class="flex flex-col md:justify-self-end">
      <span class="eyebrow mb-2">Navegue</span>
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="flex min-h-11 items-center text-[0.9375rem] text-fg-muted transition-colors duration-200 hover:text-fg [touch-action:manipulation]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container-page">
    <div
      class="flex flex-col gap-2 border-t border-border py-7 text-sm text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} {SITE.name}. Todos os direitos reservados.</span>
      <span>Feito para instituições de saúde do Brasil.</span>
    </div>
  </div>
</footer>
