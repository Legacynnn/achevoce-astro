---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { circula } from '../../data/content.ts';
import { circulaArt } from '../../lib/circulaArt';
---

<section
  data-ink
  class="on-ink circula relative isolate overflow-hidden bg-bg-ink pt-14 pb-16 sm:pt-20 sm:pb-24"
>
  <div class="container-page flex flex-wrap items-end justify-between gap-x-12 gap-y-5">
    <div class="min-w-0">
      <p class="micro text-fg-on-ink-subtle">{circula.label}</p>
      <h2 class="reveal text-h3 mt-3 max-w-[18ch] text-fg-on-ink" data-reveal>{circula.title}</h2>
    </div>
    <p class="max-w-[38ch] text-[0.8125rem] text-fg-on-ink-subtle">{circula.note}</p>
  </div>

  <div class="band-wrap relative mt-12 sm:mt-16">
    <div class="band">
      <ul
        class="band-track flex w-max items-end gap-8 sm:gap-12 lg:h-[clamp(18rem,27vw,23rem)] lg:items-stretch"
        data-track
      >
        {
          circula.cells.map((c, i) => {
            const own = circulaArt[c.slug];
            const foto = own ?? circulaArt[c.fallback];
            return (
            <li
              class:list={[
                'cell group/c relative flex shrink-0',
                c.drop && 'top-[clamp(0.75rem,2.2vw,2rem)]'
              ]}
              style={`--tone:var(--spectrum-${c.tone})`}
            >
              {foto ? (
                <figure class="flex w-[clamp(11rem,16vw,14.5rem)] flex-col lg:h-full">
                  <div
                    class="relative aspect-[3/4] overflow-hidden rounded-[20px] ring-1 ring-white/12 ring-inset lg:aspect-auto lg:min-h-0 lg:flex-1"
                  >
                    <Image
                      src={foto}
                      alt={own ? c.alt : ''}
                      widths={[240, 360, 480, 720]}
                      sizes="(min-width: 64rem) 16vw, 11rem"
                      loading="lazy"
                      class="art h-full w-full object-cover brightness-[0.82] saturate-[0.6]"
                    />
                    <span
                      class="absolute inset-0 bg-[linear-gradient(178deg,color-mix(in_oklab,var(--color-violet-950)_34%,transparent)_0%,color-mix(in_oklab,var(--color-violet-800)_72%,transparent)_100%)]"
                      aria-hidden="true"
                    />
                    <span
                      class="absolute inset-x-0 top-0 h-24 bg-[linear-gradient(to_bottom,color-mix(in_oklab,var(--color-violet-950)_62%,transparent),transparent)]"
                      aria-hidden="true"
                    />
                    <span
                      class="absolute top-3 left-3 text-[var(--tone)] opacity-90 transition-opacity duration-300 group-hover/c:opacity-100"
                      aria-hidden="true"
                    >
                      <Icon name={`hugeicons:${c.icon}`} class="h-[1.15rem] w-[1.15rem]" />
                    </span>
                    <span class="micro absolute top-4 right-4 text-white/75">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </div>
                  <figcaption class="mt-5 shrink-0">
                    <p class="font-display text-[clamp(1.25rem,1.7vw,1.625rem)] leading-[1.08] tracking-[-0.03em] text-fg-on-ink">
                      {c.label}
                    </p>
                    <p class="mt-2 text-[0.8125rem] text-fg-on-ink-subtle">{c.ex}</p>
                  </figcaption>
                </figure>
              ) : (
                <div
                  class="flex w-[clamp(11rem,17vw,15rem)] flex-col gap-7 lg:h-full lg:justify-between lg:gap-0"
                >
                  <span
                    class="grid h-12 w-12 shrink-0 place-items-center rounded-[15px] bg-[color-mix(in_oklab,var(--tone)_16%,transparent)] text-[var(--tone)] ring-1 ring-[color-mix(in_oklab,var(--tone)_28%,transparent)] ring-inset transition-colors duration-300 group-hover/c:bg-[color-mix(in_oklab,var(--tone)_28%,transparent)]"
                    aria-hidden="true"
                  >
                    <Icon name={`hugeicons:${c.icon}`} class="h-6 w-6" />
                  </span>
                  <div>
                    <span class="micro text-white/30">{String(i + 1).padStart(2, '0')}</span>
                    <p class="mt-2 font-display text-[clamp(1.5rem,2.3vw,2.125rem)] leading-[1.04] tracking-[-0.032em] text-fg-on-ink">
                      {c.label}
                    </p>
                    <span class="rule mt-5 block h-px w-full bg-white/12" aria-hidden="true" />
                    <p class="mt-3 text-[0.8125rem] text-fg-on-ink-subtle">{c.ex}</p>
                  </div>
                </div>
              )}
            </li>
            );
          })
        }
      </ul>
    </div>

    <span class="fade fade-l" aria-hidden="true"></span>
    <span class="fade fade-r" aria-hidden="true"></span>
  </div>
</section>

<style>
  .band-track {
    padding-inline: var(--page-pad);
    padding-block-end: clamp(0.75rem, 2.2vw, 2rem);
  }

  .fade {
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: clamp(1.5rem, 5vw, 5rem);
    pointer-events: none;
  }

  .fade-l {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-ink), transparent);
  }

  .fade-r {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-ink), transparent);
  }

  @media (width >= 64rem) {
    .band-track {
      transform: translate3d(calc(var(--p, 0) * -34vw), 0, 0);
      will-change: transform;
    }
  }

  .art {
    transform: scale(1.02);
  }

  .rule {
    transform-origin: left;
  }

  @media (hover: hover) and (width >= 64rem) {
    .cell {
      transition: opacity 0.4s var(--ease-out);
    }

    .art {
      transition: transform 0.9s var(--ease-out);
    }

    .cell:hover .art {
      transform: scale(1.09);
    }

    .band:hover .cell {
      opacity: 0.42;
    }

    .band:hover .cell:hover {
      opacity: 1;
    }

    .rule {
      transition:
        background-color 0.45s var(--ease-out),
        transform 0.55s var(--ease-out);
    }

    .cell:hover .rule {
      background-color: color-mix(in oklab, var(--tone) 55%, transparent);
      transform: scaleX(1.04);
    }
  }

  @media (width < 64rem) {
    .band {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .band::-webkit-scrollbar {
      display: none;
    }

    .band-track {
      transform: none;
    }

    .cell {
      scroll-snap-align: center;
    }

    .band:hover .cell {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band-track {
      transform: none !important;
    }
  }
</style>
