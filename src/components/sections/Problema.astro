---
import Eyebrow from '../ui/Eyebrow.astro';
import Mesh from '../bg/Mesh.astro';
import { problema } from '../../data/content.ts';
---

<section id="problema" class="section relative isolate overflow-hidden">
  <Mesh
    colors={['color-violet-400', 'color-violet-300']}
    intensity="subtle"
    speed={52}
    blur={130}
    count={3}
    class="-z-10"
  />

  <div class="container-page relative">
    <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-20">
      <div class="reveal lg:pt-2" data-reveal>
        <Eyebrow icon={problema.eyebrowIcon}>{problema.eyebrow}</Eyebrow>
      </div>

      <div class="max-w-3xl">
        <h2 class="text-display text-fg">
          {
            problema.title.map((line, i) => (
              <span class="line-mask" data-reveal style={`--i:${i}`}>
                <span>{line}</span>
              </span>
            ))
          }
        </h2>

        <p class="reveal text-lead measure mt-8 text-fg-muted" style="--i:2" data-reveal>
          {problema.lead}
        </p>

        <p
          class="reveal text-h2 mt-14 max-w-[26ch] border-t border-border pt-10 font-display text-fg lg:-mr-24"
          style="--i:3"
          data-reveal
        >
          {problema.closing}
        </p>
      </div>
    </div>
  </div>
</section>
