---
import { preCadastro } from '../../data/content';
import SectionHeading from '../ui/SectionHeading.astro';
import Screenshot from '../ui/Screenshot.astro';
import Reveal from '../motion/Reveal';
import formulario from '../../assets/screens/pre-cadastro-form.png';
import enviado from '../../assets/screens/pre-cadastro-enviado.png';

const shots = [formulario, enviado];
---

<section class="section">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHeading eyebrow={preCadastro.eyebrow} class="max-w-2xl">
        {preCadastro.title}
      </SectionHeading>
    </Reveal>

    <ol class="mt-16 grid gap-12 md:mt-20 md:grid-cols-2 md:gap-10">
      {
        preCadastro.steps.map((step, i) => (
          <Reveal client:visible as="li" delay={i * 0.08} className="flex h-full flex-col gap-7">
            <div class="flex items-baseline gap-4 border-t border-border-strong/60 pt-6">
              <span class="numeral text-[1.75rem] leading-none text-ghost">{i + 1}</span>
              <div>
                <h3 class="text-h3">{step.title}</h3>
                <p class="mt-2 text-fg-muted">{step.body}</p>
              </div>
            </div>
            <Screenshot src={shots[i]} alt={step.alt} sizes="(min-width: 768px) 46vw, 92vw" />
          </Reveal>
        ))
      }
    </ol>
  </div>
</section>
