---
import { Icon } from 'astro-icon/components';
import { solucao } from '../../data/content';
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../motion/Reveal';
---

<section id="solucao" class="section">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHeading eyebrow={solucao.eyebrow} class="max-w-3xl">
        {solucao.title}
        <p slot="lead" class="max-w-2xl text-lead text-fg-muted">{solucao.lead}</p>
      </SectionHeading>
    </Reveal>

    <div class="mt-16 grid border-t border-border-strong/60 md:mt-20 md:grid-cols-3">
      {
        solucao.points.map((point, i) => (
          <Reveal client:visible delay={i * 0.08} className="h-full">
            <div
              class:list={[
                'flex h-full flex-col gap-4 py-9 md:px-10 md:py-11',
                i === 0 && 'md:pl-0',
                i === solucao.points.length - 1 && 'md:pr-0',
                i > 0 && 'border-t border-border md:border-t-0 md:border-l'
              ]}
            >
              <Icon name={`lucide:${point.icon}`} class="size-6 text-fg-subtle" />
              <h3 class="mt-2 text-h3">{point.title}</h3>
              <p class="text-fg-muted">{point.body}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
