---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Mesh from '../bg/Mesh.astro';
import Beams from '../bg/Beams.astro';
import Grain from '../bg/Grain.astro';
import { ctaFinal, site } from '../../data/content.ts';
---

<section id="pre-cadastro" class="section">
  <div class="container-page">
    <div
      class="on-ink relative isolate overflow-hidden rounded-card bg-bg-ink px-7 py-16 text-fg-on-ink-muted sm:px-14 sm:py-20"
    >
      <Mesh
        colors={['color-violet-500', 'color-violet-700', 'color-violet-400']}
        intensity="bold"
        speed={32}
        blur={90}
        count={3}
      />
      <Beams count={5} angle={-12} speed={13} intensity="subtle" colors={['color-violet-300']} />
      <Grain opacity={0.12} />

      <div class="relative grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div class="max-w-xl">
          <div class="reveal" data-reveal>
            <Eyebrow tone="ink" icon={ctaFinal.eyebrowIcon}>{ctaFinal.eyebrow}</Eyebrow>
          </div>

          <h2 class="text-display mt-6 text-fg-on-ink">
            {
              ctaFinal.title.map((line, i) => (
                <span class="line-mask" data-reveal style={`--i:${i}`}>
                  <span>{line}</span>
                </span>
              ))
            }
          </h2>

          <p class="reveal text-lead mt-6 max-w-[46ch]" style="--i:2" data-reveal>
            {ctaFinal.lead}
          </p>

          <div class="reveal mt-9 flex flex-wrap items-center gap-4" style="--i:3" data-reveal>
            <Button href={site.cta} size="lg">{ctaFinal.cta}</Button>
            <span class="text-[0.8125rem] text-fg-on-ink-subtle">{ctaFinal.note}</span>
          </div>
        </div>

        <ol class="flex flex-col lg:self-center">
          {
            ctaFinal.passos.map((p, i) => (
              <li
                class="reveal flex items-baseline gap-4 border-b border-white/12 py-5 first:pt-0 last:border-0 last:pb-0"
                style={`--i:${i}`}
                data-reveal
              >
                <span class="micro shrink-0 text-violet-300">{p.n}</span>
                <span>
                  <span class="block text-[0.9375rem] font-medium text-fg-on-ink">{p.t}</span>
                  <span class="block text-[0.875rem]">{p.b}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
