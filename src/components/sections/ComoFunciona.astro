---
import { comoFunciona } from '../../data/content';
import SectionHeading from '../ui/SectionHeading.astro';
import Screenshot from '../ui/Screenshot.astro';
import Reveal from '../motion/Reveal';
import anunciar from '../../assets/screens/anunciar.png';
import meusAlertas from '../../assets/screens/meus-alertas.png';
import anuncioDetalhe from '../../assets/screens/anuncio-detalhe.png';

const shots = [anunciar, meusAlertas, anuncioDetalhe];
---

<section id="como-funciona" class="section border-y border-border bg-bg-muted">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHeading eyebrow={comoFunciona.eyebrow} class="max-w-2xl">
        {comoFunciona.title}
      </SectionHeading>
    </Reveal>

    <ol class="mt-12 flex flex-col gap-16 sm:mt-16 sm:gap-20 md:mt-20 lg:gap-0">
      {
        comoFunciona.steps.map((step, i) => (
          <li class="grid gap-8 lg:min-h-[100svh] lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-20 lg:pb-24">
            <div class="lg:sticky lg:top-[max(calc(var(--header-h)+4rem),calc(50svh-9.5rem))] lg:self-start">
              <Reveal client:visible>
                <div class="max-w-md">
                  <span class="numeral block text-[clamp(2.5rem,6vw,5rem)] leading-none text-ghost">
                    {step.number}
                  </span>
                  <h3 class="mt-5 text-h2">{step.title}</h3>
                  <p class="mt-5 text-lead text-fg-muted">{step.body}</p>
                </div>
              </Reveal>
            </div>

            <Reveal
              client:visible
              preset="scale"
              delay={0.08}
              amount={0.2}
              className="lg:sticky lg:top-[max(calc(var(--header-h)+4rem),calc(50svh-9.5rem))] lg:self-start"
            >
              <Screenshot src={shots[i]} alt={step.alt} sizes="(min-width: 1024px) 56vw, 92vw" />
            </Reveal>
          </li>
        ))
      }
    </ol>
  </div>
</section>
