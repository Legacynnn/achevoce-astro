---
import { hero } from '../../data/content';
import { CTA_URL } from '../../lib/site';
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import HeroScreen from '../motion/HeroScreen';
import marketplace from '../../assets/screens/favoritos.png';
---

<section id="top" class="relative isolate">
  <div class="aurora -z-10" aria-hidden="true"></div>

  <div class="container-page">
    <div
      class="flex min-h-[max(30rem,72svh)] flex-col justify-center pt-[calc(var(--header-h)+2rem)]"
    >
      <div class="grid lg:grid-cols-12">
        <div class="lg:col-span-9">
          <span
            class="eyebrow rise marker max-w-full rounded-pill border border-border bg-bg-raised/85 px-4 py-2 text-[0.6875rem] backdrop-blur-sm sm:text-eyebrow"
          >
            <span class="size-1.5 shrink-0 rounded-full bg-moss-600" aria-hidden="true"></span>
            {hero.eyebrow}
          </span>

          <h1 class="rise mt-7 text-display" style="animation-delay:80ms">
            <span class="block">{hero.title[0]}</span>
            <span class="block text-fg-muted italic">{hero.title[1]}</span>
          </h1>
        </div>

        <p
          class="rise mt-6 max-w-xl text-lead text-fg-muted lg:col-span-6"
          style="animation-delay:160ms"
        >
          {hero.lead}
        </p>
      </div>

      <div class="rise mt-8 flex flex-wrap items-center gap-4" style="animation-delay:240ms">
        <Button href={CTA_URL} variant="cta" size="lg">{hero.ctaPrimary}</Button>
        <Button href="#como-funciona" variant="ghost" size="lg">{hero.ctaSecondary}</Button>
      </div>

      <ul
        class="rise mt-10 grid border-t border-border sm:grid-cols-3"
        style="animation-delay:320ms"
      >
        {
          hero.proof.map((item, i) => (
            <li
              class:list={[
                'flex items-start gap-3 py-4 text-sm text-fg-subtle sm:py-5',
                i > 0 && 'border-t border-border sm:border-t-0 sm:border-l sm:pl-7',
                i > 0 && i < hero.proof.length - 1 && 'sm:pr-7'
              ]}
            >
              <svg
                class="mt-0.5 size-4 shrink-0 text-moss-600"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3.5 8.5 6.5 11.5 12.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8 md:mt-10">
      <HeroScreen client:load>
        <ProductFrame
          src={marketplace}
          alt="Tela do Ache Você com a busca por itens disponíveis e um anúncio de carrinho de emergência publicado por um hospital de Salvador."
        />
      </HeroScreen>
    </div>
  </div>
</section>
