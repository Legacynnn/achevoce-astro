---
import { hero } from '../../data/content';
import { CTA_URL } from '../../lib/site';
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import marketplace from '../../assets/screens/favoritos.png';
---

<section id="top" class="relative isolate pb-24 md:pb-32">
  <div class="aurora -z-10" aria-hidden="true"></div>

  <div class="container-page">
    <div class="flex min-h-[max(30rem,68svh)] flex-col justify-center pt-[calc(var(--header-h)+3rem)]">
      <div class="grid items-end gap-x-10 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span
            class="eyebrow rise marker max-w-full rounded-pill border border-border bg-bg-raised/85 px-4 py-2 text-[0.6875rem] backdrop-blur-sm sm:text-eyebrow"
          >
            <span class="size-1.5 shrink-0 rounded-full bg-moss-600" aria-hidden="true"></span>
            {hero.eyebrow}
          </span>

          <h1 class="rise mt-8 text-display" style="animation-delay:80ms">
            <span class="block">{hero.title[0]}</span>
            <span class="block text-fg-muted italic">{hero.title[1]}</span>
          </h1>

          <p class="rise mt-7 max-w-2xl text-lead text-fg-muted" style="animation-delay:160ms">
            {hero.lead}
          </p>

          <div class="rise mt-9 flex flex-wrap items-center gap-4" style="animation-delay:240ms">
            <Button href={CTA_URL} variant="cta" size="lg">{hero.ctaPrimary}</Button>
            <Button href="#como-funciona" variant="ghost" size="lg">{hero.ctaSecondary}</Button>
          </div>
        </div>

        <ul
          class="rise lg:col-span-4 lg:col-start-9 lg:justify-self-end"
          style="animation-delay:320ms"
        >
          {
            hero.proof.map((item, i) => (
              <li
                class:list={[
                  'flex items-start gap-3 border-t border-border py-4 text-sm text-fg-subtle',
                  i === hero.proof.length - 1 && 'border-b'
                ]}
              >
                <svg
                  class="mt-0.5 size-4 shrink-0 text-moss-600"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M3.5 8.5 6.5 11.5 12.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="container-wide mt-14 md:mt-20">
    <div class="hero-stage relative">
      <div class="screen-glow" aria-hidden="true"></div>
      <div class="hero-screen">
        <ProductFrame
          src={marketplace}
          alt="Tela do Ache Você com a busca por itens disponíveis e um anúncio de carrinho de emergência publicado por um hospital de Salvador."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    perspective: 1600px;
  }

  .hero-screen {
    transform-origin: top center;
    animation: hero-screen-in 1.2s var(--ease-out-expo) 0.35s both;
  }

  @keyframes hero-screen-in {
    from {
      opacity: 0;
      transform: translate3d(0, 56px, 0) rotateX(10deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotateX(0deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-screen {
      animation: none;
    }
  }
</style>
