---
import { hero } from '../../data/content';
import { CTA_URL } from '../../lib/site';
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import marketplace from '../../assets/screens/favoritos.png';
---

<section id="top" class="relative isolate">
  <div class="aurora -z-10" aria-hidden="true"></div>

  <div class="container-page">
    <div class="hero-copy flex flex-col justify-center pt-[calc(var(--header-h)+2.5rem)]">
      <span class="hero-in eyebrow marker max-w-full self-start rounded-pill border border-border bg-bg-raised/85 px-4 py-2 text-[0.6875rem] backdrop-blur-sm sm:text-eyebrow">
        <span class="size-1.5 shrink-0 rounded-full bg-moss-600" aria-hidden="true"></span>
        {hero.eyebrow}
      </span>

      <h1 class="hero-in mt-8 text-display" style="--d:80ms">
        <span class="block">{hero.title[0]}</span>
        <span class="block text-fg-muted italic">{hero.title[1]}</span>
      </h1>

      <div class="mt-10 grid gap-x-10 gap-y-8 lg:grid-cols-12 lg:items-end">
        <p class="hero-in max-w-xl text-lead text-fg-muted lg:col-span-6" style="--d:160ms">
          {hero.lead}
        </p>

        <div
          class="hero-in flex flex-wrap items-center gap-x-8 gap-y-4 lg:col-span-5 lg:col-start-8 lg:justify-end"
          style="--d:240ms"
        >
          <Button href={CTA_URL} variant="cta" size="lg" class="lg:order-2">
            {hero.ctaPrimary}
          </Button>
          <Button href="#como-funciona" variant="quiet" class="lg:order-1">
            {hero.ctaSecondary}
          </Button>
        </div>
      </div>

      <ul class="hero-in mt-12 grid border-t border-border sm:grid-cols-3" style="--d:320ms">
        {
          hero.proof.map((item, i) => (
            <li
              class:list={[
                'flex items-start gap-3 py-4 text-sm text-fg-subtle sm:py-5',
                i > 0 && 'border-t border-border sm:border-t-0 sm:border-l sm:pl-7',
                i < hero.proof.length - 1 && 'sm:pr-7'
              ]}
            >
              <svg
                class="mt-0.5 size-4 shrink-0 text-moss-600"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3.5 8.5 6.5 11.5 12.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page mt-12 md:mt-16">
    <div class="relative">
      <div class="screen-glow" aria-hidden="true"></div>
      <div class="hero-screen">
        <ProductFrame
          src={marketplace}
          alt="Tela do Ache Você com a busca por itens disponíveis e um anúncio de carrinho de emergência publicado por um hospital de Salvador."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-copy {
    min-height: max(28rem, 66svh);
  }

  .hero-in {
    animation: rise 0.75s var(--ease-out-expo) var(--d, 0ms) both;
  }

  .hero-screen {
    transform-origin: top center;
    animation: hero-screen-in 1.1s var(--ease-out-expo) 400ms both;
  }

  @keyframes hero-screen-in {
    from {
      opacity: 0;
      transform: perspective(1600px) translate3d(0, 48px, 0) rotateX(9deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-screen {
      animation: none;
    }
  }
</style>
