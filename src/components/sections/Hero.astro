---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Mesh from '../bg/Mesh.astro';
import Beams from '../bg/Beams.astro';
import Grain from '../bg/Grain.astro';
import Fluxo from '../widgets/Fluxo.astro';
import { hero, site } from '../../data/content.ts';
---

<section
  id="topo"
  data-ink
  class="on-ink relative isolate overflow-hidden bg-bg-ink text-fg-on-ink-muted"
>
  <Mesh
    colors={['color-violet-500', 'color-violet-700', 'color-violet-400', 'color-violet-600']}
    intensity="bold"
    speed={34}
    blur={100}
    count={4}
  />
  <Beams
    count={7}
    angle={16}
    speed={12}
    intensity="subtle"
    colors={['color-violet-300', 'color-violet-400']}
  />
  <Grain opacity={0.12} />

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,var(--color-bg-ink),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-page relative grid items-center gap-14 pt-[calc(var(--header-h)+4.5rem)] pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:gap-x-20 lg:pt-[calc(var(--header-h)+8.5rem)] lg:pb-32 xl:gap-x-28"
  >
    <div class="min-w-0 max-w-2xl">
      <div class="hero-in" style="--d:0ms">
        <Eyebrow tone="ink" icon={hero.eyebrowIcon}>{hero.eyebrow}</Eyebrow>
      </div>

      <h1 class="text-hero mt-7 text-fg-on-ink">
        {
          hero.title.map((line, i) => (
            <span class="line-mask" data-inview style={`--i:${i + 1}`}>
              <span>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="hero-in text-lead mt-7 max-w-[52ch]" style="--d:420ms">
        {hero.lead}
      </p>

      <div
        class="hero-in mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"
        style="--d:520ms"
      >
        <Button href={site.cta} size="lg" class="justify-center sm:justify-start">
          {hero.ctaPrimary}
        </Button>
        <Button
          href="#plataforma"
          variant="ghost-ink"
          size="lg"
          class="justify-center sm:justify-start"
        >
          {hero.ctaSecondary}
        </Button>
      </div>
    </div>

    <div
      class="hero-in min-w-0 lg:w-full"
      style="--d:300ms"
    >
      <div data-parallax="0.05" class="parallax-layer">
        <Fluxo />
      </div>
    </div>
  </div>

</section>

<style>
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-in {
    animation: hero-in 0.85s var(--ease-out) var(--d) both;
  }

  @media (hover: hover) and (pointer: fine) {
    .parallax-layer {
      will-change: transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
    }

    .parallax-layer {
      will-change: auto;
    }
  }
</style>
