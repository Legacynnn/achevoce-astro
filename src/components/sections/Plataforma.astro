---
import SectionHeading from '../ui/SectionHeading.astro';
import WidgetFrame from '../ui/WidgetFrame.astro';
import Esteira from '../widgets/Esteira.astro';
import Validade from '../widgets/Validade.astro';
import Alertas from '../widgets/Alertas.astro';
import Ficha from '../widgets/Ficha.astro';
import { plataforma } from '../../data/content.ts';

const skins = ['violet', 'ember', 'leaf', 'ink'] as const;

const labels: Record<string, string> = {
  esteira: 'Esteira de publicações',
  gauge: 'Painel de validade',
  alertas: 'Interesses e alertas',
  ficha: 'Cadastro da instituição'
};
---

<section id="plataforma" class="section">
  <div class="container-page">
    <SectionHeading eyebrow={plataforma.eyebrow} eyebrowIcon={plataforma.eyebrowIcon} title={plataforma.title}>
      {plataforma.lead}
    </SectionHeading>

    <div class="mt-20 flex flex-col gap-24 lg:gap-32">
      {
        plataforma.rows.map((row, i) => (
          <div
            class:list={[
              'grid items-center gap-10 lg:gap-14',
              i % 2 === 1
                ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:[&>*:first-child]:order-2'
                : 'lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]'
            ]}
          >
            <div class="min-w-0 max-w-lg">
              <div class="reveal flex items-center gap-3" data-reveal>
                <span class="micro grid h-8 w-8 place-items-center rounded-pill bg-violet-600 text-cta-fg">
                  {row.n}
                </span>
                <span class="micro rounded-pill bg-violet-100 px-2.5 py-1.5 text-violet-800">
                  {row.tag}
                </span>
              </div>

              <h3 class="text-h2 mt-6 text-fg">
                <span class="line-mask" data-reveal>
                  <span>{row.title}</span>
                </span>
              </h3>

              <p class="reveal measure mt-5 text-fg-muted" style="--i:1" data-reveal>
                {row.body}
              </p>
            </div>

            <div class="reveal min-w-0" data-reveal>
              <WidgetFrame
                label={labels[row.widget]}
                tilt={i % 2 === 1 ? 'right' : 'left'}
                skin={skins[i % skins.length]}
              >
                {row.widget === 'esteira' && <Esteira />}
                {row.widget === 'gauge' && <Validade />}
                {row.widget === 'alertas' && <Alertas />}
                {row.widget === 'ficha' && <Ficha />}
              </WidgetFrame>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
