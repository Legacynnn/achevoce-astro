---
import { Icon } from 'astro-icon/components';
import { beneficios } from '../../data/content';
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../motion/Reveal';
---

<section id="beneficios" class="section border-y border-border bg-bg-muted">
  <div class="container-page">
    <Reveal client:visible>
      <SectionHeading eyebrow={beneficios.eyebrow} class="max-w-3xl">
        {beneficios.title}
      </SectionHeading>
    </Reveal>

    <div
      class="mt-12 grid gap-px border-y border-border bg-border sm:mt-16 sm:grid-cols-2 md:mt-20 md:grid-cols-3"
    >
      {
        beneficios.items.map((item, i) => (
          <Reveal
            client:visible
            delay={(i % 3) * 0.06}
            amount={0.35}
            className="bg-bg-muted transition-colors duration-500 ease-out-expo hover:bg-bg-raised"
          >
            <article class="flex h-full flex-col gap-3 p-6 sm:p-8 md:p-10">
              <Icon name={`lucide:${item.icon}`} class="size-5 text-fg-subtle" />
              <h3 class="mt-3 text-[1.1875rem] leading-snug font-semibold">{item.title}</h3>
              <p class="text-[0.9375rem] text-fg-muted">{item.body}</p>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
