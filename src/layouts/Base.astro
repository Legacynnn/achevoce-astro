---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../lib/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImage = new URL(SITE.ogImage, Astro.site ?? SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  areaServed: 'BR'
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b0f2e" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-gabarito" preload />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-spline-mono" />

    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.dataset.js = '';
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-field focus:bg-bg focus:px-4 focus:py-2 focus:text-fg focus:shadow-md"
    >
      Ir para o conteúdo
    </a>
    <Nav />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal], [data-count]');
        if (!('IntersectionObserver' in window)) {
          document.documentElement.removeAttribute('data-js');
          return;
        }

        const countUp = (el) => {
          const to = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          if (!Number.isFinite(to)) return;
          if (reduce) {
            el.textContent = `${to}${suffix}`;
            return;
          }
          const dur = 1400;
          const t0 = performance.now();
          const tick = (t) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 4);
            el.textContent = `${Math.round(to * eased)}${suffix}`;
            if (p < 1) requestAnimationFrame(tick);
          };
          el.textContent = `0${suffix}`;
          requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const el = e.target;
              if (e.isIntersecting) {
                el.dataset.inview = '';
                if (el.dataset.count) countUp(el);
                if (!('loop' in el.dataset)) io.unobserve(el);
              } else if ('loop' in el.dataset) {
                delete el.dataset.inview;
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
        );

        for (const el of targets) io.observe(el);
      })();
    </script>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const parallax = coarse || reduce ? [] : [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      const tracks = [...document.querySelectorAll<HTMLElement>('[data-track]')];

      type Band = {
        el: HTMLElement;
        top: number;
        span: number;
        last: number;
        steps: number;
        step: number;
      };
      let bands: Band[] = [];

      const measure = () => {
        const y = scrollY;
        bands = tracks.map((el) => {
          const r = el.getBoundingClientRect();
          return {
            el,
            top: r.top + y,
            span: Math.max(1, r.height + innerHeight),
            last: -1,
            steps: Number(el.dataset.steps) || 0,
            step: -1
          };
        });
      };

      const paint = (scroll: number) => {
        for (const el of parallax) {
          const speed = Number(el.dataset.parallax) || 0.1;
          const y = Math.min(scroll * speed, 120);
          el.style.transform = `translate3d(0,${y.toFixed(1)}px,0)`;
        }
        for (const b of bands) {
          const p = (scroll + innerHeight - b.top) / b.span;
          const c = p < 0 ? 0 : p > 1 ? 1 : p;
          if (Math.abs(c - b.last) < 0.003) continue;
          b.last = c;
          b.el.style.setProperty('--p', c.toFixed(4));

          if (!b.steps) continue;
          const t = (c - 0.28) / 0.4;
          const i = Math.floor(t * b.steps);
          const step = i < 0 ? 0 : i > b.steps - 1 ? b.steps - 1 : i;
          if (step !== b.step) {
            b.step = step;
            b.el.dataset.step = String(step);
          }
        }
      };

      if (tracks.length) {
        measure();
        paint(scrollY);
        let rt = 0;
        addEventListener('resize', () => {
          clearTimeout(rt);
          rt = window.setTimeout(() => {
            measure();
            paint(scrollY);
          }, 150);
        });
        addEventListener('load', measure);
        if (document.fonts) document.fonts.ready.then(measure);
      }

      if (reduce || coarse) {
        if (tracks.length) {
          let ticking = false;
          addEventListener(
            'scroll',
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                paint(scrollY);
                ticking = false;
              });
            },
            { passive: true }
          );
        }
      } else {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1, syncTouch: false });

          lenis.on('scroll', (e: { scroll: number }) => paint(e.scroll));

          const frame = (time: number) => {
            lenis.raf(time);
            requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);

          const headerOffset = () =>
            -((document.getElementById('site-nav')?.getBoundingClientRect().height ?? 56) + 28);

          document.addEventListener('click', (e) => {
            const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
            const id = link?.getAttribute('href');
            if (!link || !id || id === '#') return;
            const target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: headerOffset() });
          });
        });
      }
    </script>

  </body>
</html>
